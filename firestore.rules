rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /lists/{doc} {
      // Legg til flere e-postadresser i listen for å gi andre tilgang
      allow read, write: if request.auth != null
        && request.auth.token.email_verified
        && request.auth.token.email in ['hakonsdahl1@gmail.com'];
    }
  }
}
